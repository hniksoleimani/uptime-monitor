apiVersion: v1
kind: Secret
metadata:
  name: uptime-monitor-secrets
  namespace: uptime-monitor
  labels:
    app: uptime-monitor
type: Opaque
stringData:
  DATABASE_URL: "postgresql+asyncpg://USER:PASSWORD@RDS_ENDPOINT:5432/uptime_monitor"
  TELEGRAM_BOT_TOKEN: "REPLACE_ME"
  TELEGRAM_CHAT_ID: "REPLACE_ME"
